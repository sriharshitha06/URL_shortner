# APP_ENV: Optional. Runtime environment label used in logs and operations docs.
APP_ENV=development

# SERVICE_NAME: Optional. Metric and log service label.
SERVICE_NAME=url-shortener

# APP_VERSION: Optional. Release identifier shown in health checks and logs.
APP_VERSION=dev-local

# PORT: Optional. HTTP port for the Express server.
PORT=3000

# LOG_LEVEL: Optional. One of info, warn, error.
LOG_LEVEL=info

# DATABASE_URL: Required unless USE_IN_MEMORY_STORE=true.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upsk_sdf

# API_KEYS: Required. JSON map of API keys to principal ids for protected endpoints.
API_KEYS={"dev-key-a":"A","dev-key-b":"B"}

# USE_IN_MEMORY_STORE: Optional. Set to true to run without PostgreSQL for local checks.
USE_IN_MEMORY_STORE=false

# DATABASE_QUERY_TIMEOUT_MS: Optional. Per-query timeout before the service fails fast.
DATABASE_QUERY_TIMEOUT_MS=1000

# DATABASE_CIRCUIT_RESET_TIMEOUT_MS: Optional. How long the breaker stays open before half-open retry.
DATABASE_CIRCUIT_RESET_TIMEOUT_MS=30000

# DATABASE_CIRCUIT_VOLUME_THRESHOLD: Optional. Minimum request volume before breaker error percentage is evaluated.
DATABASE_CIRCUIT_VOLUME_THRESHOLD=5

# DATABASE_CIRCUIT_ERROR_THRESHOLD_PERCENT: Optional. Error percentage that opens the breaker.
DATABASE_CIRCUIT_ERROR_THRESHOLD_PERCENT=50

# DATABASE_RETRY_ATTEMPTS: Optional. Number of retry attempts after the initial database call fails.
DATABASE_RETRY_ATTEMPTS=2

# DATABASE_RETRY_BASE_DELAY_MS: Optional. Starting delay for exponential backoff.
DATABASE_RETRY_BASE_DELAY_MS=100

# DATABASE_RETRY_MAX_DELAY_MS: Optional. Maximum backoff delay.
DATABASE_RETRY_MAX_DELAY_MS=500

# DATABASE_RETRY_JITTER_MS: Optional. Random jitter range added to each retry delay.
DATABASE_RETRY_JITTER_MS=50
